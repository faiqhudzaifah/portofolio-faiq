---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Sidebar from '../components/Sidebar.astro';
import Introduction from '../components/Introduction.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import karakterImg from '../assets/karakter.webp'; 
---

<Layout 
  title="Portfolio - Muhammad Faiq Hudzaifah" 
  description="Portofolio resmi Muhammad Faiq Hudzaifah. Berisi kompilasi project web development, desain, dan sertifikasi."
>
  <main id="main-content" class="max-w-6xl mx-auto px-6 py-4">
    <!-- Hero Section -->
    <Hero 
      titleTop="PORT" 
      titleBottom="FOLIO" 
      characterImg={karakterImg}
      subtitles={["Compilation", "Projects & Certifications", "2026"]} 
      altText="Ilustrasi karakter Faiq Hudzaifah menyambut pengunjung di halaman portofolio utama."
    />
    
    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mt-8 md:mt-16 pb-20">
      <!-- Kiri: 4 Kolom -->
      <div class="lg:col-span-4">
        <Sidebar />
      </div>
      
      <!-- Kanan: 8 Kolom -->
      <div class="lg:col-span-8">
        <Introduction />
		
		<Certifications />
        <Skills />
      </div>
    </div>
  </main>
</Layout>