---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const certs = await getCollection('certifications');
const experience = await getCollection('experience');

const courses = certs.flatMap((c) => c.data.courses ?? []);
const tracks = new Set(courses.map((c) => c.track).filter(Boolean));
const certCount = certs.reduce((n, c) => n + (c.data.courses?.length ?? 1), 0);
const projectCount = experience.filter((e) => e.data.type === 'project').length;

const stats = [
  { value: String(certCount), label: 'Certificates' },
  { value: String(tracks.size), label: 'Learning tracks' },
  { value: String(projectCount), label: 'Projects' },
  { value: profile.education.gpa, label: 'GPA' },
];
---
<ul class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 print:mt-4">
  {stats.map((s, i) => (
    <li class:list={['brutal-card px-4 py-5 text-center', i === 0 && 'bg-brand']}>
      <p class="font-display font-black text-4xl md:text-5xl leading-none">{s.value}</p>
      <p class="font-display font-bold text-xs uppercase tracking-widest mt-2 text-gray-800">{s.label}</p>
    </li>
  ))}
</ul>
