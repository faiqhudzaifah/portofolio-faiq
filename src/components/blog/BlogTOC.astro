---
// src/components/blog/BlogTOC.astro
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasHeadings = filteredHeadings.length > 0;
---

{hasHeadings && (
  <>
    <!-- Versi Desktop: Sticky di tengah layar, bisa di-scroll sendiri jika panjang -->
    <div class="sticky top-24 hidden lg:block max-h-[calc(100vh-120px)] overflow-y-auto pr-2 custom-scrollbar">
      <h3 class="text-xs font-bold text-black uppercase tracking-widest mb-4 sticky top-0 bg-white py-2 z-10 border-b border-gray-100">
        Daftar Isi
      </h3>
      <nav class="relative border-l-2 border-gray-200 pl-4 py-2">
        <ul class="space-y-3 text-sm font-medium text-gray-600">
          {filteredHeadings.map((heading) => (
            <li>
              <a 
                href={`#${heading.slug}`} 
                class={`hover:text-brand-dark hover:font-bold transition-all block line-clamp-2 ${heading.depth === 3 ? 'ml-3 text-xs' : ''}`}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Versi Mobile: Accordion -->
    <details class="group lg:hidden mb-6 bg-white border-2 border-black rounded-2xl p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
      <summary class="flex items-center justify-between cursor-pointer list-none text-xs font-bold text-black uppercase tracking-widest [&::-webkit-details-marker]:hidden">
        Daftar Isi
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 shrink-0 transition-transform duration-200 group-open:rotate-180">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </summary>
      <nav class="mt-4 border-l-2 border-gray-200 pl-4">
        <ul class="space-y-3 text-sm font-medium text-gray-600">
          {filteredHeadings.map((heading) => (
            <li>
              <a 
                href={`#${heading.slug}`} 
                class={`hover:text-brand-dark transition-colors block ${heading.depth === 3 ? 'ml-3 text-xs' : ''}`}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </>
)}