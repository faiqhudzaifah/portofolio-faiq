---
// src/components/blog/BlogNavigation.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { prevPost, nextPost } = Astro.props;
---
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
  {prevPost ? (
    <a href={`/blog/${prevPost.id}`} class="group border-2 border-black rounded-xl p-6 bg-white shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-y-1 hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] hover:bg-brand transition-all flex flex-col justify-center">
      <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-2 block group-hover:text-black">&larr; Artikel Sebelumnya</span>
      <h4 class="text-lg font-bold text-black">{prevPost.data.title}</h4>
    </a>
  ) : <div></div>}

  {nextPost && (
    <a href={`/blog/${nextPost.id}`} class="group border-2 border-black rounded-xl p-6 bg-white shadow-[4px_4px_0px_rgba(0,0,0,1)] hover:-translate-y-1 hover:shadow-[6px_6px_0px_rgba(0,0,0,1)] hover:bg-brand transition-all flex flex-col justify-center text-right">
      <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-2 block group-hover:text-black">Artikel Selanjutnya &rarr;</span>
      <h4 class="text-lg font-bold text-black">{nextPost.data.title}</h4>
    </a>
  )}
</div>