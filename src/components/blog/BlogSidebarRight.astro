---
// src/components/blog/BlogSidebarRight.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;

const tags = post.data.tags || ['astro', 'elysia'];
const readingTime = post.data.readingTime || '5 menit';
---

<div class="sticky top-24 hidden lg:block">
  
  <!-- INFORMASI -->
  <!-- border-b memunculkan garis bawah tipis, pb-6 memberi jarak dalam, mb-8 jarak luar -->
  <div class="border-b border-gray-200 pb-6 mb-8">
    <h3 class="text-xs font-bold text-black uppercase tracking-widest mb-6">Informasi</h3>
    <ul class="space-y-4 text-sm font-medium text-gray-600">
      <li class="flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-500">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        {readingTime}
      </li>
      <li class="flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-500">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
        Diperbarui {post.data.pubDate.toLocaleDateString()}
      </li>
    </ul>
  </div>

  <!-- BAGIKAN -->
  <div class="border-b border-gray-200 pb-6 mb-8">
    <h3 class="text-xs font-bold text-black uppercase tracking-widest mb-6">Bagikan</h3>
    <ul class="space-y-4 text-sm font-medium text-gray-600">
      <li>
        <button class="hover:text-brand-dark flex items-center gap-3 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
          </svg>
          Salin Link
        </button>
      </li>
      <li>
        <a href="#" class="hover:text-brand-dark flex items-center gap-3 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-gray-500">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          Twitter
        </a>
      </li>
      <li>
        <a href="#" class="hover:text-brand-dark flex items-center gap-3 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-gray-500">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </li>
    </ul>
  </div>

  <!-- TAGS (Tanpa border bawah karena paling akhir) -->
  <div>
    <h3 class="text-xs font-bold text-black uppercase tracking-widest mb-6">Tags</h3>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag: string) => (
        <a href={`/tags/${tag}`} class="px-3 py-1.5 border border-gray-200 rounded-lg text-xs font-medium text-gray-600 hover:border-brand hover:text-brand-dark transition-colors">
          #{tag}
        </a>
      ))}
    </div>
  </div>

</div>

<!-- Versi Mobile: tanggal & tags sudah tampil di BlogHeader, jadi di sini cukup tombol bagikan -->
<div class="lg:hidden mb-10 bg-white border-2 border-black rounded-2xl p-5 shadow-[4px_4px_0px_rgba(0,0,0,1)]">
  <h3 class="text-xs font-bold text-black uppercase tracking-widest mb-4">Bagikan Artikel</h3>
  <div class="flex items-center gap-3">
    <button 
      aria-label="Salin Link"
      class="w-11 h-11 flex items-center justify-center border-2 border-black rounded-full text-black hover:bg-brand hover:text-black hover:border-brand transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
      </svg>
    </button>
    <a 
      href="#" 
      aria-label="Bagikan ke Twitter"
      class="w-11 h-11 flex items-center justify-center border-2 border-black rounded-full text-black hover:bg-brand hover:text-black hover:border-brand transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>
    <a 
      href="#" 
      aria-label="Bagikan ke LinkedIn"
      class="w-11 h-11 flex items-center justify-center border-2 border-black rounded-full text-black hover:bg-brand hover:text-black hover:border-brand transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
    </a>
  </div>
</div>