---
import { getEntry } from 'astro:content';
import SectionTitle from './SectionTitle.astro';

const skillsData = await getEntry('skills', 'data');
const hardSkills = skillsData?.data.hardSkills ?? [];
const softSkills = skillsData?.data.softSkills ?? [];
---
<section id="skills" class="mt-20 scroll-mt-8">
  <SectionTitle title="Skills" note="tools I reach for" />

  <h3 class="text-xs font-display font-bold tracking-widest text-gray-800 mb-3">TECH STACK</h3>
  <ul class="flex flex-wrap gap-2.5 mb-8">
    {hardSkills.map((skill) => <li class="chip chip-brand shadow-[2px_2px_0px_#000]">{skill}</li>)}
  </ul>

  <h3 class="text-xs font-display font-bold tracking-widest text-gray-800 mb-3">INTERESTS</h3>
  <ul class="flex flex-wrap gap-2.5">
    {softSkills.map((i) => <li class="border-2 border-black text-black font-display font-bold text-xs tracking-wider uppercase py-1.5 px-4 rounded-full bg-white">{i}</li>)}
  </ul>
</section>
