---
import { profile } from '../data/profile';
import SectionTitle from './SectionTitle.astro';

const contacts = [
  { icon: '📍', label: profile.location },
  { icon: '📞', label: profile.phone, href: profile.phoneHref },
  { icon: '✉️', label: profile.email, href: `mailto:${profile.email}` },
  { icon: '🔗', label: profile.links.github.replace('https://', ''), href: profile.links.github },
];
const edu = profile.education;
---
<section id="introduction" class="scroll-mt-8" aria-labelledby="intro-title">
  <SectionTitle title="Introduction" note="about me" />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="brutal-card p-5">
      <h3 class="text-xs font-display font-bold tracking-widest text-gray-800 mb-3 border-b-2 border-black pb-1">PROFILE &amp; CONTACT</h3>
      <p class="text-xl font-display font-bold mb-4">{profile.name}</p>
      <ul class="text-sm space-y-2 text-gray-700 font-medium">
        {contacts.map((c) => (
          <li class="flex items-start gap-2">
            <span aria-hidden="true">{c.icon}</span>
            {c.href
              ? <a href={c.href} class="underline decoration-brand decoration-2 underline-offset-2 hover:bg-brand break-all">{c.label}</a>
              : <span>{c.label}</span>}
          </li>
        ))}
      </ul>
    </div>

    <div class="brutal-card p-5">
      <h3 class="text-xs font-display font-bold tracking-widest text-gray-800 mb-3 border-b-2 border-black pb-1">EDUCATION</h3>
      <p class="text-xl font-display font-bold mb-1">{edu.school}</p>
      <p class="text-sm text-gray-700 font-medium">{edu.degree}</p>
      <p class="text-sm text-gray-700 font-medium mb-3">{edu.period}</p>
      <span class="chip chip-brand">GPA {edu.gpa}</span>
    </div>
  </div>
</section>
