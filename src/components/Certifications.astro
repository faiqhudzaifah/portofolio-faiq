---
// src/components/Certifications.astro
import { getCollection } from 'astro:content';
import Divider from './Divider.astro';

// Ambil semua data sertifikasi dan urutkan berdasarkan field 'order'
const certEntries = await getCollection('certifications');
const certifications = certEntries.sort((a, b) => a.data.order - b.data.order);
---

<div class="mt-12">
  <Divider/>
  
  <div class="text-center">
    <h3 class="text-[10px] font-display font-bold tracking-[0.2em] mb-8">CERTIFICATIONS & TRAINING</h3>
  </div>
  
  <div class="space-y-6">
    {certifications.map(cert => (
      <div class="relative pl-4 border-l-2 border-brand">
        <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-black"></div>
        
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-1">
          <h4 class="text-sm font-display font-bold uppercase text-black flex items-center gap-2">
            {cert.data.program}
            
            <!-- Jika cuma 1 sertifikat (pakai icon link standar) -->
            {cert.data.link && !cert.data.multipleLinks && (
              <a href={cert.data.link} target="_blank" rel="noopener noreferrer" class="text-brand-dark hover:text-black transition-colors" title="Buka Sertifikat">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            )}
          </h4>
          <span class="text-[10px] font-bold text-gray-500 whitespace-nowrap sm:ml-4">{cert.data.date}</span>
        </div>
        
        <p class="text-[11px] font-bold text-brand-dark mb-1">{cert.data.issuer}</p>
        <p class="text-[10px] text-gray-600 leading-tight font-medium pr-4 mb-2">{cert.data.details}</p>

        <!-- Jika ada banyak sertifikat (multipleLinks), render sebagai deretan tombol kecil -->
        {cert.data.multipleLinks && (
          <div class="flex flex-wrap gap-2 mt-2">
            {cert.data.multipleLinks.map((doc) => (
              <a 
                href={doc.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-[9px] font-bold uppercase tracking-wider bg-white border border-black px-2 py-1 hover:bg-brand hover:text-black transition-colors shadow-[1px_1px_0px_rgba(0,0,0,1)]"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                </svg>
                {doc.label}
              </a>
            ))}
          </div>
        )}  
      </div>
    ))}
  </div>
</div>