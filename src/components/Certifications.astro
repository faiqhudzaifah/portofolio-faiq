---
import { getCollection } from 'astro:content';
import SectionTitle from './SectionTitle.astro';

const certs = (await getCollection('certifications')).sort((a, b) => a.data.order - b.data.order);
// Checker resmi DTS (sama dengan QR di sertifikat): ?registrasi=<nomor sebelum garis miring pertama>
const verifyUrl = (credential: string) => `https://digitalent.komdigi.go.id/cek-sertifikat?registrasi=${credential.split('/')[0]}`;
const linkIcon = 'M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25';
---
<section id="certifications" class="mt-20 scroll-mt-8">
  <SectionTitle title="Certifications" note="& training" />

  <div class="space-y-6">
    {certs.map((cert) => {
      const courses = cert.data.courses ?? [];
      return (
        <article class="brutal-card p-5">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
            <div>
              <h3 class="text-lg font-display font-black leading-tight">{cert.data.program}</h3>
              <p class="text-sm font-bold text-brand-dark">{cert.data.issuer}</p>
            </div>
            <span class="chip chip-brand whitespace-nowrap self-start">{cert.data.date}</span>
          </div>
          <p class="text-sm text-gray-700 font-medium leading-relaxed mt-3">{cert.data.details}</p>

          {cert.data.link && (
            <a href={cert.data.link} target="_blank" rel="noopener noreferrer" class="brutal-btn mt-4 !py-1.5 !text-xs">
              View certificate
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d={linkIcon} /></svg>
            </a>
          )}

          {courses.length > 0 && (
            <>
              <p class="text-xs font-display font-bold uppercase tracking-widest text-gray-500 mt-5 mb-2">
                {courses.length} courses · verifiable at digitalent.komdigi.go.id
              </p>
              <ul class="divide-y-2 divide-black border-2 border-black rounded-lg overflow-hidden">
                {courses.map((c) => (
                  <li class="flex flex-col sm:flex-row sm:items-center gap-x-4 gap-y-1 px-3 py-2.5 bg-white">
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-display font-bold leading-snug">{c.name}</p>
                      <p class="text-xs text-gray-600 font-medium">
                        {c.track && <span class="font-bold text-brand-dark">{c.track}</span>}
                        {c.track && ' · '}{c.date}
                      </p>
                      <p class="text-[11px] text-gray-500 font-mono break-all mt-0.5">ID {c.credential}</p>
                    </div>
                    <div class="flex gap-2 shrink-0 self-start sm:self-center">
                      <a href={verifyUrl(c.credential)} target="_blank" rel="noopener noreferrer" aria-label={`Verifikasi kredensial ${c.name} di situs DTS`} class="chip chip-brand hover:bg-white transition-colors !py-1 !text-[11px] uppercase tracking-wider">Verify ↗</a>
                      {c.url && <a href={c.url} target="_blank" rel="noopener noreferrer" aria-label={`Buka sertifikat ${c.name} (PDF)`} class="chip hover:bg-brand transition-colors !py-1 !text-[11px] uppercase tracking-wider">PDF ↗</a>}
                    </div>
                  </li>
                ))}
              </ul>
            </>
          )}
        </article>
      );
    })}
  </div>
</section>
