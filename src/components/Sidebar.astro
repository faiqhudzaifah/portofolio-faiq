---
// Impor komponen Image bawaan Astro
import { Image } from 'astro:assets';


import profileImg from '../assets/faiq-photo.webp';

import SocialsAstroComponent from './Socials.astro';
---
<div class="flex flex-col">
  <!-- Photo Box -->
  <!-- Menghapus bg-brand dan mengatur ukurannya agar pas dengan kontainer -->
  <div class="aspect-[3/4] w-full relative mb-8 overflow-hidden bg-gray-100 border-2 border-black rounded-xl shadow-[4px_4px_0px_#000] print:max-w-[140px] print:shadow-none">
    
    <!-- Gambar Profil Full Cover -->
    <Image 
      src={profileImg} 
      alt="Foto Muhammad Faiq Hudzaifah" 
      class="w-full h-full object-cover object-center"
    />
    
  </div>
  
  <p class="text-5xl font-display font-bold mb-4" aria-hidden="true">_hey,</p>
  
  <p class="text-sm text-gray-700 leading-relaxed font-medium">
    I'm an Informatics Engineering student at STMIK Mardira Indonesia focusing on data analysis and data science. I've completed Komdigi's Digital Talent Scholarship AI &amp; Data Scientist path (7 certified courses), from Python and data cleansing to deep learning and LLMs, and I apply it in hands-on projects like Otentik, a CNN that detects AI-generated faces. Outside of data, I design, build software, and host Podcast Faiq Hudzaifah.
  </p>

  <!-- Socials Component -->
    <SocialsAstroComponent />

</div>