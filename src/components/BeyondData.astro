---
import { linkGroups } from '../data/links';
import SectionTitle from './SectionTitle.astro';
---
<section id="beyond" class="mt-20 scroll-mt-8 print:hidden">
  <SectionTitle title="Beyond the Data" note="content & creative work" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {linkGroups.map((g) => (
      <div class="brutal-card p-4">
        <h3 class="text-xs font-display font-bold tracking-widest text-gray-800 mb-3 border-b-2 border-black pb-1 uppercase">{g.title}</h3>
        <ul class="flex flex-wrap gap-2">
          {g.items.map((i) => (
            <li><a href={i.url} target="_blank" rel="noopener noreferrer" class="chip hover:bg-brand transition-colors">{i.label} ↗</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
