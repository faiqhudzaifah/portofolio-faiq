---
// src/components/BlogToolbar.astro
interface Props {
  years: number[];
}
const { years } = Astro.props;
---

<div class="flex flex-col md:flex-row justify-center items-center py-8 mb-8 gap-4">
  
  <!-- Search Input -->
  <div class="relative w-full md:w-64">
    <!-- TAMBAHAN: Label sr-only agar dibaca oleh screen reader -->
    <label for="searchInput" class="sr-only">Cari artikel berdasarkan judul atau kata kunci</label>
    
    <!-- TAMBAHAN: aria-hidden="true" agar icon SVG diabaikan screen reader -->
    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-dark" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
    </span>
    <input 
      type="text" 
      id="searchInput"
      placeholder="Cari artikel..." 
      class="w-full pl-11 pr-4 py-2 text-sm font-bold text-brand-dark border border-brand rounded-full bg-transparent placeholder-brand-dark/60 focus:outline-none focus:ring-2 focus:ring-brand/30 transition-shadow"
    />
  </div>

  <!-- Filter Tahun -->
  <div class="relative w-full md:min-w-[180px] md:w-auto">
    <!-- TAMBAHAN: Label sr-only -->
    <label for="yearFilter" class="sr-only">Filter artikel berdasarkan tahun publikasi</label>
    
    <select id="yearFilter" class="w-full px-5 py-2 pr-10 text-sm font-bold text-brand-dark border border-brand rounded-full uppercase tracking-widest appearance-none bg-transparent cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand/30">
      <option value="all">Semua Tahun</option>
      {years.map((year: number) => (
        <option value={year}>{year}</option>
      ))}
    </select>
    
    <!-- TAMBAHAN: aria-hidden="true" -->
    <span class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-brand-dark" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </span>
  </div>

  <!-- Tombol Populer -->
  <button 
    id="popularBtn"
    class="w-full md:w-auto bg-brand text-black hover:bg-black hover:text-white border border-brand rounded-lg px-6 py-2 text-xs font-bold uppercase tracking-widest hover:opacity-90 transition-opacity flex items-center justify-center gap-2 shadow-sm"
  >
    <!-- TAMBAHAN: aria-hidden="true" agar screen reader langsung membaca teks tombolnya saja -->
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.866 8.21 8.21 0 0 0 3 2.48Z" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.468 5.99 5.99 0 0 0-1.925 3.547 5.975 5.975 0 0 1-2.133-1.001A3.75 3.75 0 0 0 12 18Z" />
    </svg>
    Paling Banyak Dibaca
  </button>
</div>