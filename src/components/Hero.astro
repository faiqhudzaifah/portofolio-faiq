---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  titleTop: string;
  titleBottom: string;
  characterImg: ImageMetadata;
  subtitles: [string, string, string];
  altText?: string;
}

const { titleTop, titleBottom, characterImg, subtitles, altText = "Ilustrasi karakter maskot Faiq Hudzaifah" } = Astro.props;
---

<!-- Divider / Header Tebal Khusus Hero -->
<div class="flex items-center w-full pt-4 mb-16 print:hidden">
  <div class="w-12 h-3 bg-black skew-x-[-45deg] mr-2"></div>
  <div class="w-6 h-3 bg-black skew-x-[-45deg] mr-4"></div>
  <div class="h-[3px] bg-black flex-grow"></div>
  <div class="ml-4 font-display font-black text-xl tracking-widest uppercase flex items-center gap-2">
    FAIQ HZF
    <span aria-hidden="true" class="w-5 h-5 bg-black text-white rounded-full flex items-center justify-center text-[10px] font-bold leading-none">✦</span>
  </div>
</div>

<div class="text-center py-4 flex flex-col items-center print:hidden">
  <div class="relative inline-block">
    <h1 class="text-[100px] md:text-[180px] font-display font-black leading-[0.8] tracking-tighter text-black relative z-0 uppercase">
      {titleTop}<br/>{titleBottom}
    </h1>
    
    <Image 
      src={characterImg} 
      alt={altText}
      class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[250px] md:w-[400px] z-10 pointer-events-none drop-shadow-xl"
    />
  </div>
  
  <!-- Subtitle Dinamis -->
  <div class="flex flex-wrap items-center justify-center gap-4 text-brand-dark font-display font-bold uppercase tracking-widest mt-12 text-xs md:text-sm">
    <span>{subtitles[0]}</span>
    <span>✦</span>
    <span>{subtitles[1]}</span>
    <span>✦</span>
    <span>{subtitles[2]}</span>
  </div>

  <slot />
</div>
