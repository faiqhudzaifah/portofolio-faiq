---
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<!-- Wrapper Navigasi Floating -->
<div class="fixed bottom-6 left-6 z-50">
  
  <!-- Pop-up Menu -->
  <div 
    id="folder-menu" 
    class="absolute bottom-full left-0 mb-4 bg-white border-2 border-black rounded-2xl shadow-[4px_4px_0px_rgba(0,0,0,1)] flex flex-col overflow-hidden min-w-[160px] transform scale-0 opacity-0 origin-bottom-left transition-all duration-300 ease-out pointer-events-none"
  >
    <div class="bg-gray-100 border-b-2 border-black px-4 py-2 text-[10px] font-display font-bold tracking-widest text-gray-500 flex justify-between items-center">
      <span>/ROOT</span>
      <span class="w-2 h-2 rounded-full bg-brand"></span>
    </div>
    <div class="flex flex-col p-2 gap-1">
      
      <!-- Tombol Home dengan SVG -->
      <a 
        href="/" 
        aria-current={isActive('/') ? "page" : undefined}
        class={`px-4 py-2 text-sm font-display font-bold rounded-lg transition-colors flex items-center gap-2 ${
          isActive('/') ? 'bg-gray-800 text-white' : 'hover:bg-gray-800 hover:text-white'
        }`}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z" />
          <path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z" />
        </svg>
        Home
      </a>
      
      <!-- Tombol Gallery dengan SVG -->
      <a 
        href="/gallery" 
        aria-current={isActive('/gallery') ? "page" : undefined}
        class={`px-4 py-2 text-sm font-display font-bold rounded-lg transition-colors flex items-center gap-2 ${
          isActive('/gallery') ? 'bg-brand text-black' : 'hover:bg-brand hover:text-black'
        }`}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path fill-rule="evenodd" d="M1.5 6a2.25 2.25 0 0 1 2.25-2.25h16.5A2.25 2.25 0 0 1 22.5 6v12a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 18V6ZM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0 0 21 18v-1.94l-2.69-2.689a1.5 1.5 0 0 0-2.12 0l-.88.879.97.97a.75.75 0 1 1-1.06 1.06l-5.16-5.159a1.5 1.5 0 0 0-2.12 0L3 16.061Zm10.125-7.81a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Z" clip-rule="evenodd" />
        </svg>
        Gallery
      </a>
      
      <!-- Tombol Blog dengan SVG -->
      <a 
        href="/blog" 
        aria-current={isActive('/blog') ? "page" : undefined}
        class={`px-4 py-2 text-sm font-display font-bold rounded-lg transition-colors flex items-center gap-2 ${
          isActive('/blog') ? 'bg-black text-white' : 'hover:bg-black hover:text-white'
        }`}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
          <path fill-rule="evenodd" d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0 0 16.5 9h-1.875a1.875 1.875 0 0 1-1.875-1.875V5.25A3.75 3.75 0 0 0 9 1.5H5.625ZM7.5 15a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5A.75.75 0 0 1 7.5 15Zm.75 2.25a.75.75 0 0 0 0 1.5H12a.75.75 0 0 0 0-1.5H8.25Z" clip-rule="evenodd" />
          <path d="M12.971 1.816A5.23 5.23 0 0 1 14.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 0 1 3.434 1.279 9.768 9.768 0 0 0-6.963-6.963Z" />
        </svg>
        Blog
      </a>
      
    </div>
  </div>

  <!-- Tombol Trigger (Folder Icon) -->
  <button 
    id="folder-btn" 
    class="w-14 h-14 bg-white border-2 border-black rounded-full flex items-center justify-center hover:bg-brand hover:text-black transition-colors shadow-[4px_4px_0px_rgba(0,0,0,1)] focus:outline-none z-10 relative group"
    aria-label="Tutup Menu Navigasi"
    aria-expanded="false"
    aria-controls="folder-menu"
  >
    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 transition-transform group-hover:scale-110">
      <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.146V6a3 3 0 0 1 3-3h5.379a2.25 2.25 0 0 1 1.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 0 1 3 3v1.146A4.483 4.483 0 0 0 19.5 9h-15a4.483 4.483 0 0 0-3 1.146Z" />
    </svg>
  </button>
</div>

<!-- Logika Interaksi Animasi -->
<script>
  const btn = document.getElementById('folder-btn');
  const menu = document.getElementById('folder-menu');
  let isOpen = false;

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    isOpen = !isOpen;
    
    // Toggle aria-expanded untuk Screen Reader
    btn.setAttribute('aria-expanded', String(isOpen));
    
    if (isOpen) {
      menu?.classList.remove('scale-0', 'opacity-0', 'pointer-events-none');
      menu?.classList.add('scale-100', 'opacity-100', 'pointer-events-auto');
      btn.setAttribute('aria-label', 'Tutup Menu Navigasi');
    } else {
      menu?.classList.add('scale-0', 'opacity-0', 'pointer-events-none');
      menu?.classList.remove('scale-100', 'opacity-100', 'pointer-events-auto');
      btn.setAttribute('aria-label', 'Buka Menu Navigasi');
    }
  });

  document.addEventListener('click', (e) => {
    if (isOpen && menu && !menu.contains(e.target as Node)) {
      isOpen = false;
      btn?.setAttribute('aria-expanded', 'false');
      btn?.setAttribute('aria-label', 'Buka Menu Navigasi');
      menu.classList.add('scale-0', 'opacity-0', 'pointer-events-none');
      menu.classList.remove('scale-100', 'opacity-100', 'pointer-events-auto');
    }
  });
</script>